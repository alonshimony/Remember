{
  "name": "remember",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "sync": "tsx tools/memory-sync/index.ts",
    "mcp": "tsx tools/mcp/index.ts",
    "format": "prettier --write .",
    "db:types": "tsx tools/generate-types.ts",
    "archive": "tsx tools/archive.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx tools/migrate.ts",
    "vercel-build": "npm run db:migrate -- --if-configured && next build"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.2",
    "@js-temporal/polyfill": "^0.5.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dexie": "^4.4.6",
    "fflate": "^0.8.3",
    "lucide-react": "^1.46.0",
    "next": "^16.3.5",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "type": "module"
}
