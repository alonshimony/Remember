# Public values; local Supabase values come from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_ENV=development
APP_URL=http://localhost:3000
# Server/worker only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=
OPENAI_ANSWER_MODEL=
OPENAI_EMBEDDING_MODEL=
AI_DAILY_REQUEST_LIMIT=30
WORKER_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:configure@example.com
BACKUP_DESTINATION=
# Set via SQL invitation before user provisioning; no public signup.
# Offline plaintext storage is opt-in per browser and owner.
