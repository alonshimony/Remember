# Required: copy these four values into Vercel -> Project -> Settings -> Environment Variables.
# Neon Console -> Connect -> pooled connection string (keep sslmode=require).
DATABASE_URL=
# Clerk Dashboard -> API keys. Use test keys for a first *.vercel.app preview.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# The verified Clerk email allowed to create the first workspace.
OWNER_EMAIL=

# Optional: no AI provider is needed to capture and search notes.
NEXT_PUBLIC_APP_ENV=production
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=
OPENAI_ANSWER_MODEL=
OPENAI_EMBEDDING_MODEL=
AI_DAILY_REQUEST_LIMIT=30

# Optional worker and push. Vercel automatically supplies CRON_SECRET to Cron requests.
CRON_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
BACKUP_DESTINATION=
# Optional canonical origin; normal same-origin requests work without this.
APP_URL=
